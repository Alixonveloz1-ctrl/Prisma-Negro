# Variables de entorno de Prisma-Negro
#
# El repositorio es PÚBLICO (§1 del plano). Ni un identificador de proyecto, ni un
# correo de cuenta de servicio, ni un nombre de almacén puede aparecer en el código.
# Todo vive aquí, y este archivo se copia con valores reales SOLO en el panel de la
# plataforma serverless — nunca se sube relleno.
#
# La auditoría comprueba que ningún valor real de estos se haya colado en el árbol
# de fuentes (invariante «sin secretos en el código»).

# ── Cuenta de servicio (la única credencial del sistema) ───────────────────────
# Correo de la cuenta de servicio.
GCP_CUENTA_SERVICIO=
# Clave privada PEM. Los saltos de línea van escapados como \n en una sola línea.
GCP_CLAVE_PRIVADA=
# Identificador del proyecto en la nube.
GCP_PROYECTO=
# Número del proyecto (aparece dentro de los nombres de operación).
GCP_NUMERO_PROYECTO=

# ── Almacén ───────────────────────────────────────────────────────────────────
# Nombre del bucket donde vive TODO lo generado. Es la única fuente de verdad.
ALMACEN_NOMBRE=
# Prefijo dentro del bucket (permite compartir bucket entre herramientas).
ALMACEN_PREFIJO=prisma-negro

# ── Proveedor de IA ───────────────────────────────────────────────────────────
GCP_REGION_IA=us-central1
MODELO_TEXTO=gemini-2.5-pro
MODELO_IMAGEN=gemini-2.5-flash-image
MODELO_VIDEO=veo-3.1-generate-preview
MODELO_MUSICA=lyria-002
# §7.9: para narración larga se elige CONSISTENCIA sobre expresividad.
MODELO_VOZ=texto-a-voz-neural
VOZ_REGION=es-US

# ── Montador (trabajo pesado, contenedor efímero) ─────────────────────────────
GCP_REGION_JOB=us-central1
MONTADOR_JOB=prisma-negro-montador

# ── Cifrado de referencias opacas ─────────────────────────────────────────────
# 32 bytes en hexadecimal (64 caracteres). Genérala una vez y no la cambies:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# §6: los identificadores de operación llevan dentro el identificador del proyecto.
# El censor los borraría y la consulta siguiente fallaría con un error
# incomprensible. Por eso se CIFRAN en vez de censurarlos.
CLAVE_REFERENCIAS=

# ── Acceso a la herramienta ───────────────────────────────────────────────────
# Contraseña única para usar la herramienta. Sin esto, cualquiera que encuentre la
# URL gasta la cuota de la nube del usuario.
CLAVE_ACCESO=
